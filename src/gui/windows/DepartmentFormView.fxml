<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.windows.DepartmentFormController">
   <children>
      <GridPane layoutX="14.0" layoutY="14.0" prefWidth="300.0" AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="14.0">
